# Public site URL — set once the real domain is live (enables indexing, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=

# Contact form: Web3Forms access key (free, from web3forms.com). Without it the
# form opens the visitor's email app instead. On GitHub: repo variable WEB3FORMS_KEY.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Local only: preview unpublished release records. Never enable in production.
SHOW_DRAFT_CONTENT=false
